# ============================================================================
# AbrIT Platform — Environment Variables
# Copy to .env and fill in real values. NEVER commit real secrets.
# ============================================================================

# --- Database (PostgreSQL — MANDATORY for production) ------------------------
# Prisma connection string (canonical business data: customers, orders,
# payments, subscriptions, Drive accounts, tickets, notifications).
# POSTGRES_PASSWORD is REQUIRED for docker compose (there is deliberately no
# insecure default). Generate one: openssl rand -hex 24
# Local development convenience: docker/compose.dev.yml pins a dev password —
# use `docker compose -f docker-compose.yml -f docker/compose.dev.yml up`.
POSTGRES_PASSWORD=""
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/abrit_portal?schema=public"

# --- Service-to-service contract (Orchard Core ⇄ Next.js) --------------------
# Shared secret (min 16 chars) that lets the REAL Orchard Core administration
# (/admin) read canonical business records through /api/admin/*.
# The same value must be configured in the Orchard app under
# AbrIT:CommerceApi:ServiceToken. Generate: openssl rand -hex 24
ABRIT_SERVICE_TOKEN=""

# --- Grant hashing (OTP / password-recovery codes) — audit §3.5 --------------
# DEDICATED HMAC secret for storing low-entropy grant codes. REQUIRED in
# production (there is no fallback — the former ABRIT_SERVICE_TOKEN fallback
# was removed by engineering review). Generate: openssl rand -hex 32
# Rotation: set the NEW value here and move the old value to
# OTP_HMAC_SECRET_PREVIOUS — in-flight grants keep verifying during the window.
OTP_HMAC_SECRET=""
OTP_HMAC_SECRET_PREVIOUS=""

# --- Reverse proxy to the real Orchard Core administration -------------------
# The Orchard Core application (CMS admin at /admin) — Next.js proxies every
# path that is not one of its own routes to this target. The proxy pins the
# upstream ORIGIN (path segments are re-encoded), restricts methods, strips
# internal credentials and enforces the limits below (full-remediation §2.1,
# host-trust hardening in final-remediation P1-2).
ORCHARD_PROXY_TARGET="http://127.0.0.1:5000"
# PUBLIC host names this deployment is reachable under (comma/space separated,
# e.g. "portal.example.com, www.portal.example.com"). The CMS proxy reports
# only these hosts upstream (Host / X-Forwarded-Host) — an inbound request
# with any other Host header cannot influence CMS-generated URLs or
# redirects. Leave empty in unproxied/dev setups: the proxy then reports the
# ORCHARD_PROXY_TARGET host and never forwards client-controlled values.
ABRIT_TRUSTED_PUBLIC_HOSTS=""
# Set to "true" ONLY when an operator-controlled reverse proxy in front of
# the portal pins the Host header and sanitizes x-real-ip / x-forwarded-for
# (the repo's Caddy gateway and any standard Caddy/Nginx TLS edge do this).
# Effects: (1) the CMS proxy forwards the inbound Host/X-Forwarded-* as-is;
# (2) the public rate limiter (contact form, quote endpoint) keys on
# x-real-ip / x-forwarded-for. When "false"/empty, spoofed headers are
# ignored: the proxy derives Host from configuration and rate limiting uses
# a single shared bucket (no spoofed-IP bypass).
ABRIT_TRUST_PROXY_HEADERS="false"
# Upstream timeout for proxied CMS requests, milliseconds (default 60000,
# clamped 1000–600000). Timeout → controlled 504 response.
ORCHARD_PROXY_TIMEOUT_MS=""
# Maximum proxied request body in BYTES for CMS paths (Orchard media uploads
# are larger than the 1 MiB JSON cap; default 64 MiB, clamped 1 KiB–1 GiB).
ABRIT_PROXY_MAX_BODY_BYTES=""
# CMS debug port binding (docker compose). Default 127.0.0.1 — production must
# NOT change this (administration goes through the public proxy at /admin).
CMS_BIND="127.0.0.1"
CMS_PORT="5001"
# Durable SMS outbox for the CMS (docker compose wires AbrIT__SmsDatabase to
# the Orchard PostgreSQL database automatically; documented here because it
# is part of the deployment contract — full-remediation audit §4.5).
# AbrIT__SmsDatabase: see docker-compose.yml (service: cms).

# --- Docker compose orchestration (values consumed by docker-compose.yml) ---
# Public port for the portal container (default 3000).
PORTAL_PORT="3000"
# Run Prisma migrations (migrate deploy) before the portal starts (default true).
RUN_MIGRATIONS="true"
# Seed the database after migrations (default false; see prisma/seed.ts).
SEED_ON_START="false"
# Allow local/plain payment callbacks for manual testing (default false —
# NEVER enable in production).
ABRIT_PAYMENTS_ALLOW_LOCAL_CALLBACK="false"
ABRIT_LOCAL_DEV="false"
# Operator-only Orchard admin bootstrap via CLI (default false).
ABRIT_ADMIN_BOOTSTRAP_ENABLED="false"
ABRIT_ORCHARD_ADMIN_USERNAME="abrit-admin"
ABRIT_ORCHARD_ADMIN_EMAIL="admin@abrit.ir"
ABRIT_ORCHARD_ADMIN_PASSWORD=""

# --- SMS.ir (official Verify API — https://sms.ir/web-service/) ---------------
# PLACEHOLDER — put your real SMS.ir API key in .env (never committed).
SMSIR_API_KEY=""
SMSIR_TEMPLATE_ID=""
SMSIR_OTP_PARAMETER_NAME=Code
SMSIR_API_BASE_URL="https://api.sms.ir"
SMSIR_TIMEOUT_MS="15000"
# (Internal aliases SMSIR_OTP_TEMPLATE_ID / SMSIR_CODE_PARAMETER_NAME also work.)

# --- OTP policy ----------------------------------------------------------------
OTP_PROVIDER=sms
# Code length actually enforced by the generator AND the verifier (4..8).
OTP_CODE_LENGTH=6
OTP_EXPIRY_SECONDS=120
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=3
# OTP_DELIVERY_MODE: "sms" (production — real SMS.ir delivery) | "display"
# (isolated development ONLY — the code is returned in the API response and
# clearly labeled; requesting display mode with NODE_ENV=production is
# rejected). When credentials are configured but no designated test mobile
# number has been supplied, keep this on "display" — never send SMS to
# arbitrary numbers.
OTP_DELIVERY_MODE="display"

# --- Payment gateways (Sandbox — never live in this phase) --------------------
# Public documented sandbox defaults (no real credentials). Override with the
# merchant values from each provider's sandbox console.
ABRIT_PAYMENTS_ZARINPAL_MERCHANT_ID=""
ABRIT_PAYMENTS_ZARINPAL_SANDBOX="true"
ABRIT_PAYMENTS_ZARINPAL_ENABLED="true"
ABRIT_PAYMENTS_ZIBAL_MERCHANT="zibal"
ABRIT_PAYMENTS_ZIBAL_ENABLED="true"
# REQUIRED for Zarinpal/Zibal, including local Docker: the public HTTPS origin
# of THIS Portal (for local testing, use an HTTPS tunnel to localhost:3000).
# Example: https://your-tunnel.example — never a PSP URL or localhost.
# Add the tunnel origin here once available; no payment attempt is created
# while this setting is empty.
ABRIT_PAYMENTS_PUBLIC_BASE_URL=""
# Internal dev/test gateway (NEVER enable in production):
ABRIT_PAYMENTS_MOCK_ENABLED="false"

# --- Password recovery ----------------------------------------------------------
# RECOVERY_DELIVERY_MODE: "display" (dev only) | "email" (production intent).
# Email mode additionally requires a real provider (RECOVERY_EMAIL_PROVIDER_URL)
# — none is integrated yet, so email recovery stays DISABLED (honest 503) and
# the supported production channel is MOBILE recovery via SMS.ir OTP.
RECOVERY_DELIVERY_MODE="display"
RECOVERY_EMAIL_PROVIDER_URL=""

# --- AbrIT Drive (Nextcloud — real production integration) ---------------------
NEXTCLOUD_MODE=live
NEXTCLOUD_BASE_URL=https://drive.abrit.cloud
NEXTCLOUD_ADMIN_USER=""
NEXTCLOUD_ADMIN_APP_PASSWORD=""
NEXTCLOUD_DEFAULT_QUOTA=100MB
DRIVE_LOGIN_URL=https://drive.abrit.cloud/login
NEXTCLOUD_TIMEOUT_MS="8000"
# DEVELOPMENT-ONLY override to allow plain-HTTP Nextcloud URLs. Ignored
# (with a warning) when NODE_ENV=production — admin credentials never travel
# over plain HTTP in production.
NEXTCLOUD_ALLOW_INSECURE="false"

# --- HTTP hardening (audit §3.6) -------------------------------------------------
# Maximum accepted JSON request body for /api routes (default 1 MiB, max 16 MiB).
ABRIT_MAX_JSON_BODY_BYTES=""
# Optional full Content-Security-Policy override (rare special deployments).
ABRIT_CSP=""
# Set to "off" to disable the default security headers (not recommended).
ABRIT_SECURITY_HEADERS="on"

# --- Diagnostics (isolated debugging only — never in production) ---------------
PRISMA_LOG_QUERY="0"
