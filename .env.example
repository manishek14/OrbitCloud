# ============================================================================
# AbrIT Platform — Environment Variables
# Copy to .env and fill in real values. NEVER commit real secrets.
# ============================================================================

# --- Database (PostgreSQL — MANDATORY for production) ------------------------
# Prisma connection string (canonical business data: customers, orders,
# payments, subscriptions, Drive accounts, tickets, notifications).
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/abrit_portal?schema=public"

# --- Service-to-service contract (Orchard Core ⇄ Next.js) --------------------
# Shared secret (min 16 chars) that lets the REAL Orchard Core administration
# (/admin) read canonical business records through /api/admin/*.
# The same value must be configured in the Orchard app under
# AbrIT:CommerceApi:ServiceToken. Generate: openssl rand -hex 24
ABRIT_SERVICE_TOKEN=""

# --- Reverse proxy to the real Orchard Core administration -------------------
# The Orchard Core application (CMS admin at /admin) — Next.js proxies every
# path that is not one of its own routes to this target.
ORCHARD_PROXY_TARGET="http://127.0.0.1:5000"

# --- SMS.ir (official Verify API — https://sms.ir/web-service/) ---------------
# PLACEHOLDER — put your real SMS.ir API key in .env (never committed).
SMSIR_API_KEY=""
SMSIR_TEMPLATE_ID=""
SMSIR_OTP_PARAMETER_NAME=Code
SMSIR_API_BASE_URL="https://api.sms.ir"
SMSIR_TIMEOUT_MS="15000"
# (Internal aliases SMSIR_OTP_TEMPLATE_ID / SMSIR_CODE_PARAMETER_NAME also work.)

# --- OTP policy ----------------------------------------------------------------
OTP_PROVIDER=sms
OTP_CODE_LENGTH=6
OTP_EXPIRY_SECONDS=120
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=3
# OTP_DELIVERY_MODE: "sms" (production — real SMS.ir delivery) | "display"
# (isolated development ONLY — the code is returned in the API response and
# clearly labeled; requesting display mode with NODE_ENV=production is
# rejected). When credentials are configured but no designated test mobile
# number has been supplied, keep this on "display" — never send SMS to
# arbitrary numbers.
OTP_DELIVERY_MODE="display"

# --- Payment gateways (Sandbox — never live in this phase) --------------------
# Public documented sandbox defaults (no real credentials). Override with the
# merchant values from each provider's sandbox console.
ABRIT_PAYMENTS_ZARINPAL_MERCHANT_ID=""
ABRIT_PAYMENTS_ZARINPAL_SANDBOX="true"
ABRIT_PAYMENTS_ZARINPAL_ENABLED="true"
ABRIT_PAYMENTS_ZIBAL_MERCHANT="zibal"
ABRIT_PAYMENTS_ZIBAL_ENABLED="true"
# REQUIRED for Zarinpal/Zibal, including local Docker: the public HTTPS origin
# of THIS Portal (for local testing, use an HTTPS tunnel to localhost:3000).
# Example: https://your-tunnel.example — never a PSP URL or localhost.
# Add the tunnel origin here once available; no payment attempt is created
# while this setting is empty.
ABRIT_PAYMENTS_PUBLIC_BASE_URL=""
# Internal dev/test gateway (NEVER enable in production):
ABRIT_PAYMENTS_MOCK_ENABLED="false"

# --- Password recovery (email channel) ----------------------------------------
# RECOVERY_DELIVERY_MODE: "display" (dev only) | "email" (production, never
# returns the code). Mobile recovery always goes through SMS.ir OTP.
RECOVERY_DELIVERY_MODE="display"

# --- AbrIT Drive (Nextcloud — real production integration) ---------------------
NEXTCLOUD_MODE=live
NEXTCLOUD_BASE_URL=https://drive.abrit.cloud
NEXTCLOUD_ADMIN_USER=""
NEXTCLOUD_ADMIN_APP_PASSWORD=""
NEXTCLOUD_DEFAULT_QUOTA=100MB
DRIVE_LOGIN_URL=https://drive.abrit.cloud/login
NEXTCLOUD_TIMEOUT_MS="8000"
NEXTCLOUD_ALLOW_INSECURE="false"
# Production guard: NEXTCLOUD_MODE must be "live" with real credentials when
# NODE_ENV=production — simulation silently fails configuration there.

# --- Diagnostics (isolated debugging only — never in production) ---------------
PRISMA_LOG_QUERY="0"
