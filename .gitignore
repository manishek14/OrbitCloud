# See https://help.github.com/articles/ignoring-files/ for more about ignore files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real secrets are NEVER committed; the *.example templates are
.env*
!.env.example
!orchard/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------------------
# Repository hygiene (audit §9): generated output, local runtime state,
# database backups and sandbox tooling never belong in version control.
# ---------------------------------------------------------------------------

# local runtime state & logs
*.log
dev.log
dev.out.log
server.log
orchard-runtime.log
*.pid
prompt
test

# database backups / dumps (may contain user data)
*.dump
*.sql.bak
backups/

# generated tool output & agent working directories
tool-results/
agent-ctx/
analysis/
.z-ai-config
.claude

# uploaded source archives and scratch artifacts (keep the repo source-only)
upload/
download/

# sandbox/dev-environment scripts (not part of the application)
.zscripts/
examples/

# editor backup files
*.backup
*.bak
*.orig
*.rej
