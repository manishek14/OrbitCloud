@model IReadOnlyList<CommerceCustomer>
@{
    var query = (string?)ViewBag.Query;
}
<div class="abrit-ops">
    <a class="abrit-ops__back" href="/Admin/AbrIT">بازگشت به داشبورد</a>
    <header class="abrit-ops__page-heading"><span class="abrit-ops__eyebrow">مدیریت کسب‌وکار</span><h1>مشتریان</h1><p>@Model.Count حساب — از منبع کانونی (PostgreSQL) خوانده شده است.</p></header>
    <form class="abrit-ops__filters" method="get" action="/Admin/AbrIT/Customers">
        <label for="customer-query">جست‌وجو بر اساس نام، ایمیل یا شماره همراه</label>
        <div>
            <input id="customer-query" name="query" value="@query" type="search" autocomplete="off" />
            <button type="submit">جست‌وجو</button>
            @if (!string.IsNullOrWhiteSpace(query)) { <a href="/Admin/AbrIT/Customers">پاک‌کردن</a> }
        </div>
    </form>
    @if (Model.Count == 0)
    {
        <p class="abrit-ops__muted">مشتری‌ای یافت نشد.</p>
    }
    else
    {
        <div class="abrit-admin-table-wrap">
            <table class="abrit-admin-table">
                <caption class="sr-only">فهرست مشتریان AbrIT</caption>
                <thead><tr><th scope="col">مشتری</th><th scope="col">شماره همراه</th><th scope="col">سفارش‌ها</th><th scope="col">مجموع پرداخت (تومان)</th><th scope="col">Drive</th><th scope="col">اشتراک فعال</th><th scope="col">وضعیت</th></tr></thead>
                <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td><a href="/Admin/AbrIT/Customers/@c.Id"><strong>@(c.Name ?? "—")</strong><small dir="ltr">@c.Email</small></a></td>
                        <td dir="ltr">@(c.Mobile ?? "—")</td>
                        <td>@c.OrderCount</td>
                        <td>@ViewFormats.FaToman(c.PaidTotalToman)</td>
                        <td>@(c.HasDrive ? "فعال" : "—")</td>
                        <td>@(c.ActiveSubscription ?? "—")</td>
                        <td><span class="abrit-status-badge @(c.Status == "active" ? "is-active" : "is-muted")">@(c.Status == "active" ? "فعال" : "غیرفعال")</span></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
