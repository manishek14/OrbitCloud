@model CommerceReport
<div class="abrit-ops">
    <a class="abrit-ops__back" href="/Admin/AbrIT">بازگشت به داشبورد</a>
    <header class="abrit-ops__page-heading"><span class="abrit-ops__eyebrow">مدیریت کسب‌وکار</span><h1>گزارش‌ها</h1><p>همه ارقام از تراکنش‌های تأییدشده سمت سرور و رکوردهای واقعی مشتق شده‌اند.</p></header>

    <section class="abrit-ops__stats">
        <article class="abrit-ops__stat"><span>سفارش‌های پرداخت‌شده</span><strong>@Model.TotalPaidOrders</strong></article>
        <article class="abrit-ops__stat"><span>درآمد کل (تومان)</span><strong>@Model.TotalRevenueToman.ToString("N0")</strong></article>
    </section>

    <div class="abrit-ops__grid">
        <section class="abrit-ops__card">
            <div class="abrit-ops__card-heading"><span class="abrit-ops__label">مالی</span><h2>درآمد ماهانه</h2></div>
            <ul class="abrit-ops__status-list">
                @foreach (var m in Model.RevenueByMonth)
                {
                    <li><span dir="ltr">@m.Month</span><strong>@m.TotalToman.ToString("N0") تومان (@m.OrderCount سفارش)</strong></li>
                }
            </ul>
        </section>
        <section class="abrit-ops__card">
            <div class="abrit-ops__card-heading"><span class="abrit-ops__label">فروش</span><h2>وضعیت سفارش‌ها</h2></div>
            <ul class="abrit-ops__status-list">
                @foreach (var s in Model.OrdersByStatus)
                {
                    <li><span>@s.Status</span><strong>@s.Count</strong></li>
                }
            </ul>
        </section>
        <section class="abrit-ops__card">
            <div class="abrit-ops__card-heading"><span class="abrit-ops__label">فروش</span><h2>توزیع پکیج‌ها</h2></div>
            <ul class="abrit-ops__status-list">
                @foreach (var p in Model.PlanDistribution)
                {
                    <li><span>@p.PackageNameFa</span><strong>@p.Count اشتراک</strong></li>
                }
            </ul>
        </section>
    </div>
</div>
