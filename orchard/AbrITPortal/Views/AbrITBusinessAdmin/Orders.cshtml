@model IReadOnlyList<CommerceOrder>
<div class="abrit-ops">
    <a class="abrit-ops__back" href="/Admin/AbrIT">بازگشت به داشبورد</a>
    <header class="abrit-ops__page-heading"><span class="abrit-ops__eyebrow">مدیریت کسب‌وکار</span><h1>سفارش‌ها</h1><p>@Model.Count سفارش — هر سفارش اسنپ‌شات تغییرناپذیر قیمت دارد که سمت سرور محاسبه شده است.</p></header>
    @if (Model.Count == 0)
    {
        <p class="abrit-ops__muted">سفارشی ثبت نشده است.</p>
    }
    else
    {
        <div class="abrit-admin-table-wrap">
            <table class="abrit-admin-table">
                <caption class="sr-only">فهرست سفارش‌ها</caption>
                <thead><tr><th scope="col">شماره سفارش</th><th scope="col">مشتری</th><th scope="col">اقلام</th><th scope="col">مبلغ (تومان)</th><th scope="col">وضعیت</th><th scope="col">تاریخ ثبت</th><th scope="col">پرداخت</th></tr></thead>
                <tbody>
                @foreach (var o in Model)
                {
                    <tr>
                        <td dir="ltr"><strong>@o.OrderNumber</strong></td>
                        <td>@(o.CustomerName ?? o.CustomerEmail ?? "—")</td>
                        <td>@o.ItemCount</td>
                        <td>@ViewFormats.FaToman(o.TotalToman)</td>
                        <td>
                            <span class="abrit-status-badge @(o.Status == "paid" ? "is-active" : o.Status == "pending_payment" ? "is-pending" : o.Status == "cancelled" ? "is-danger" : "is-info")">
                                @(o.Status == "paid" ? "پرداخت‌شده" : o.Status == "pending_payment" ? "در انتظار پرداخت" : o.Status == "cancelled" ? "لغوشده" : o.Status)
                            </span>
                        </td>
                        <td dir="ltr">@ViewFormats.CompactDate(o.CreatedAt)</td>
                        <td dir="ltr">@ViewFormats.CompactDate(o.PaidAt)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
