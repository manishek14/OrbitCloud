@model AbrITPortal.Areas.Admin.Controllers.UnavailableViewModel
<div class="abrit-ops">
    <a class="abrit-ops__back" href="/Admin/AbrIT">بازگشت به داشبورد</a>
    <header class="abrit-ops__page-heading"><span class="abrit-ops__eyebrow">مدیریت کسب‌وکار Orbit</span><h1>@Model.Title</h1></header>
    <section class="abrit-ops__card">
        <p class="abrit-ops__unavailable">@Model.Message</p>
        <p class="abrit-ops__note">داده‌های کسب‌وکار (مشتریان، سفارش‌ها، پرداخت‌ها، اشتراک‌ها و حساب‌های Drive) از منبع کانونی — اپلیکیشن Next.js — از طریق قرارداد سرویس‌به‌سرویس خوانده می‌شوند و در Orchard کپی نمی‌شوند.</p>
    </section>
</div>
