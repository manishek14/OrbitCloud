@{ ViewLayout = "Layout__Login"; }
<div class="auth-shell">
  <section class="auth-card" style="max-width:560px;margin:0 auto">
    <div class="auth-card__head"><span class="eyebrow">بازیابی حساب</span><h1>فراموشی گذرواژه</h1><p>نام کاربری یا ایمیل خود را وارد کنید. اگر بازیابی ایمیلی برای حساب شما فعال باشد، لینک/راهنما ارسال می‌شود.</p></div>
    <div class="auth-card__body">
      @if (!ViewContext.ModelState.IsValid) { <div class="auth-error" role="alert">لطفاً اطلاعات واردشده را بررسی کنید.</div> }
      @await DisplayAsync(Model)
      <div class="portal-alert portal-alert--info" style="margin-top:1rem"><span><strong>بازیابی با شماره همراه (OTP):</strong> اگر شماره همراه تأییدشده دارید، می‌توانید از <a href="/customer/recover">بازیابی و ورود با کد پیامکی</a> استفاده کنید.</span></div>
      <div class="auth-links" style="margin-top:1rem"><a href="/Login">بازگشت به ورود</a><a href="/customer/recover">بازیابی با OTP</a></div>
    </div>
  </section>
</div>
