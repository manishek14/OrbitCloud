@{ ViewLayout = "Layout__Login"; }
<div class="auth-shell">
  <section class="auth-card" style="max-width:560px;margin:0 auto">
    <div class="auth-card__head"><span class="eyebrow">بازیابی حساب</span><h1>بازنشانی گذرواژه</h1><p>گذرواژه جدید خود را وارد کنید.</p></div>
    <div class="auth-card__body">
      @if (!ViewContext.ModelState.IsValid) { <div class="auth-error" role="alert">لطفاً اطلاعات واردشده را بررسی کنید.</div> }
      @await DisplayAsync(Model)
      <div class="auth-links" style="margin-top:1rem"><a href="/Login">ورود</a><a href="/customer/recover">بازیابی با OTP</a></div>
    </div>
  </section>
</div>
