<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#101A30">
  <title>{% page_title Site.SiteName, position: "before", separator: " - " %}</title>
  {% resources type: "Meta" %}
  <link rel="preload" href="{{ 'AbrITPortalTheme/fonts/Vazirmatn-Regular.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="{{ 'AbrITPortalTheme/fonts/Vazirmatn-Bold.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="{{ 'AbrITPortalTheme/css/abrit-portal.css' | asset_url }}">
  <link rel="stylesheet" href="{{ 'AbrITPortalTheme/css/abrit-customer-polish.css' | asset_url }}">
  {% resources type: "HeadLink" %}{% resources type: "Stylesheet" %}{% resources type: "HeadScript" %}
</head>
<body class="abrit-auth-page">
  <a class="skip-link" href="#main-content">پرش به محتوای اصلی</a>
  <header class="portal-header">
    <div class="portal-header__inner">
      <a class="portal-brand" href="/services">
        <span class="portal-brand__mark"><svg width="22" height="22" viewBox="0 0 48 48" fill="none" aria-hidden="true"><rect width="48" height="48" rx="11" fill="#0B2447"/><path d="M13.5 34.5 24 13l10.5 21.5" stroke="#F4F8FF" stroke-width="4.4" stroke-linecap="round" stroke-linejoin="round"/><path d="M18.2 26.6h11.6" stroke="#3E9BFF" stroke-width="4.4" stroke-linecap="round"/></svg></span>
        <span>Orbit<span class="portal-brand__sub">پرتال مشتریان</span></span>
      </a>
      <nav class="portal-nav" aria-label="ناوبری اصلی">
        <a class="portal-nav__link" href="/services">خدمات</a>
        <span class="portal-nav__spacer"></span>
        <div class="portal-nav__auth">
          <a class="portal-button portal-button--secondary" href="/Login">ورود</a>
          <a class="portal-button portal-button--primary" href="/customer/register">ثبت‌نام</a>
        </div>
      </nav>
    </div>
  </header>
  <main class="portal-main" id="main-content"><div class="portal-container portal-page">{% render_body %}</div></main>
  <footer class="portal-footer portal-footer--compact">
    <div class="portal-footer__bottom">© Orbit — تمامی حقوق محفوظ است.</div>
  </footer>
  {% resources type: "FootScript" %}
</body>
</html>