{% assign fields = Model.ContentItem.Content.AbrITService %}
<section class="portal-section service-detail" aria-labelledby="service-detail-title">
  <a class="back-link" href="/services">بازگشت به سرویس‌ها</a>
  <div class="detail-layout">
    <section class="panel detail-main">
      <span class="service-card__icon" aria-hidden="true">{{ fields.Icon.Text | default: "◈" }}</span>
      <span class="eyebrow">سرویس ابری AbrIT</span>
      <h1 id="service-detail-title">{{ fields.title.Text | default: Model.ContentItem.DisplayText }}</h1>
      <p>{{ fields.Description.Text | default: "توضیحاتی برای این سرویس ثبت نشده است." }}</p>
      <div class="portal-alert portal-alert--info" role="status">
        <span>قیمت‌گذاری نهایی پلن‌های تجاری P1 تا P5 از موتور قیمت‌گذاری مرکزی محاسبه می‌شود. خرید آنلاین پس از اتصال امن سفارش و پرداخت (M3) فعال خواهد شد.</span>
      </div>
    </section>
    <aside class="detail-aside">
      <div class="panel price-card">
        <span class="price-card__label">قیمت پایه (نمایشی)</span>
        <strong class="price-card__amount">{{ fields.Price.Value | default: "—" }} <small>تومان</small></strong>
        <div class="price-card__divider"></div>
        <a class="portal-button portal-button--secondary" href="/services">مشاهده پلن‌های P1 تا P5</a>
        <button class="portal-button portal-button--primary" type="button" disabled aria-disabled="true">ثبت سفارش (به‌زودی - M3)</button>
        <p class="price-card__note">پرداخت و ایجاد سفارش آنلاین در این مرحله فعال نیست. پیش‌نمایش قیمت در صفحه سرویس‌ها دقیق و مبتنی بر سرور است.</p>
      </div>
    </aside>
  </div>
</section>