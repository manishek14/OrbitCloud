@*
    AbrIT branded shell for the Orchard admin password-recovery request
    (/ForgotPassword). The original OrchardCore.Users form is rendered
    through DisplayAsync — all server-side behavior is preserved.
*@
@{
    ViewLayout = "Layout__Login";
    var hasError = !ViewContext.ModelState.IsValid;
}
<style asp-name="abrit-admin" at="Head"></style>
<div class="abrit-auth">
    <div class="abrit-auth__panel">
        <div class="abrit-auth__brand">
            <img class="abrit-auth__mark" src="~/AbrITAdminTheme/img/abrit-icon.svg" alt="نماد AbrIT" width="44" height="44" />
            <span class="abrit-auth__brandname">
                <strong>AbrIT</strong>
                <small>مدیریت سامانه — بازیابی گذرواژه</small>
            </span>
        </div>

        <section class="abrit-auth__card" aria-labelledby="abrit-forgot-title">
            <h1 class="abrit-auth__title" id="abrit-forgot-title">بازیابی گذرواژه مدیر</h1>
            <p class="abrit-auth__subtitle">
                ایمیل یا نام کاربری حساب مدیر خود را وارد کنید تا پیوند بازیابی ارسال شود.
            </p>

            @if (hasError)
            {
                <div class="abrit-auth__error" role="alert">
                    اطلاعات ارسالی معتبر نیست؛ دوباره تلاش کنید.
                </div>
            }

            @await DisplayAsync(Model)

            <div class="abrit-auth__links" style="margin-top: 1rem;">
                <a href="/Login">بازگشت به ورود مدیر</a>
                <a href="/auth/login">ورود مشتریان AbrIT</a>
            </div>
        </section>
    </div>
</div>
