@*
    AbrIT branded shell for the Orchard admin password reset (/ResetPassword).
    The original OrchardCore.Users form is rendered through DisplayAsync —
    all server-side behavior is preserved.
*@
@{
    ViewLayout = "Layout__Login";
    var hasError = !ViewContext.ModelState.IsValid;
}
<style asp-name="abrit-admin" at="Head"></style>
<div class="abrit-auth">
    <div class="abrit-auth__panel">
        <div class="abrit-auth__brand">
            <img class="abrit-auth__mark" src="~/AbrITAdminTheme/img/abrit-icon.svg" alt="نماد AbrIT" width="44" height="44" />
            <span class="abrit-auth__brandname">
                <strong>AbrIT</strong>
                <small>مدیریت سامانه — تعیین گذرواژه جدید</small>
            </span>
        </div>

        <section class="abrit-auth__card" aria-labelledby="abrit-reset-title">
            <h1 class="abrit-auth__title" id="abrit-reset-title">تعیین گذرواژه جدید</h1>
            <p class="abrit-auth__subtitle">
                گذرواژه جدید خود را انتخاب کنید. گذرواژه باید حداقل ۸ نویسه باشد.
            </p>

            @if (hasError)
            {
                <div class="abrit-auth__error" role="alert">
                    اطلاعات ارسالی معتبر نیست؛ شرایط گذرواژه را بررسی و دوباره تلاش کنید.
                </div>
            }

            @await DisplayAsync(Model)

            <div class="abrit-auth__links" style="margin-top: 1rem;">
                <a href="/Login">بازگشت به ورود مدیر</a>
            </div>
        </section>
    </div>
</div>
