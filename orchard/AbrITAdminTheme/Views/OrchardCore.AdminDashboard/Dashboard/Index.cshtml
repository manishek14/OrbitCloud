@inject AbrITAdminTheme.Admin.IAdminDashboardDataProvider DashboardDataProvider
@{
    var data = await DashboardDataProvider.GetAsync(Context.RequestAborted);
}
<main class="abrit-admin-dashboard">
    <header class="abrit-dashboard-heading">
        <div>
            <span class="abrit-admin-eyebrow">مدیریت AbrIT</span>
            <h1>داشبورد عملیاتی</h1>
            <p>نمای کلی مشتریان، سفارش‌ها و سرویس‌های سامانه بر اساس داده‌های ثبت‌شده.</p>
        </div>
        <nav class="abrit-dashboard-actions" aria-label="دسترسی سریع">
            <a class="btn btn-outline-secondary" href="/Admin/dashboard/manage">مدیریت ویجت‌ها</a>
            <a class="btn btn-outline-secondary" href="/Admin/AbrIT/Customers">مدیریت مشتریان</a>
            <a class="btn btn-primary" href="/Admin/AbrIT/Orders">مشاهده سفارش‌ها</a>
        </nav>
    </header>

    <section class="abrit-dashboard-kpis" aria-label="شاخص‌های عملیاتی">
        <article class="abrit-dashboard-kpi abrit-dashboard-kpi--customers">
            <span class="abrit-dashboard-kpi__label">مشتریان</span>
            <strong class="abrit-dashboard-kpi__value">@data.Customers</strong>
            <a href="/Admin/AbrIT/Customers">فهرست مشتریان <span aria-hidden="true">←</span></a>
        </article>
        <article class="abrit-dashboard-kpi abrit-dashboard-kpi--orders">
            <span class="abrit-dashboard-kpi__label">کل سفارش‌ها</span>
            <strong class="abrit-dashboard-kpi__value">@data.Orders</strong>
            <a href="/Admin/AbrIT/Orders">فهرست سفارش‌ها <span aria-hidden="true">←</span></a>
        </article>
        <article class="abrit-dashboard-kpi abrit-dashboard-kpi--pending">
            <span class="abrit-dashboard-kpi__label">سفارش‌های در انتظار</span>
            <strong class="abrit-dashboard-kpi__value">@data.PendingOrders</strong>
            <small>وضعیت سفارش‌ها در ۱۰۰ مورد اخیر</small>
        </article>
        <article class="abrit-dashboard-kpi abrit-dashboard-kpi--unavailable">
            <span class="abrit-dashboard-kpi__label">سرویس‌های فعال</span>
            <strong class="abrit-dashboard-kpi__value abrit-dashboard-kpi__value--unavailable">@data.ActiveServices</strong>
            <small>اطلاعات سرویس مستقل از سفارش در دسترس نیست</small>
        </article>
        <article class="abrit-dashboard-kpi">
            <span class="abrit-dashboard-kpi__label">تلاش‌های پرداخت</span>
            <strong class="abrit-dashboard-kpi__value">@data.PaymentAttempts</strong>
            <small>۱۰۰ مورد اخیر</small>
        </article>
        <article class="abrit-dashboard-kpi">
            <span class="abrit-dashboard-kpi__label">پرداخت‌های ناموفق</span>
            <strong class="abrit-dashboard-kpi__value">@data.FailedPayments</strong>
            <small>از @data.PaymentAttempts پرداخت اخیر</small>
        </article>
        <article class="abrit-dashboard-kpi">
            <span class="abrit-dashboard-kpi__label">پیامک در صف</span>
            <strong class="abrit-dashboard-kpi__value">@data.SmsQueue</strong>
            <small>۱۰۰ مورد اخیر</small>
        </article>
        <article class="abrit-dashboard-kpi">
            <span class="abrit-dashboard-kpi__label">پیامک‌های ناموفق</span>
            <strong class="abrit-dashboard-kpi__value">@data.FailedSms</strong>
            <small>@data.SmsQueue پیامک در صف یا در حال تلاش</small>
        </article>
    </section>

    <div class="abrit-dashboard-columns">
        <section class="abrit-dashboard-panel">
            <div class="abrit-dashboard-panel__heading">
                <div><span class="abrit-admin-eyebrow">فروش و عملیات</span><h2>سفارش‌های اخیر</h2></div>
                <a href="/Admin/AbrIT/Orders">مشاهده همه <span aria-hidden="true">←</span></a>
            </div>
            @if (data.RecentOrders.Count == 0)
            {
                <div class="abrit-admin-empty-state">
                    <strong>هنوز سفارشی ثبت نشده است</strong>
                    <p>پس از ثبت سفارش، آخرین موارد در این بخش نمایش داده می‌شوند.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table abrit-admin-table">
                        <thead><tr><th>عنوان سفارش</th><th>وضعیت</th><th>تاریخ ثبت</th></tr></thead>
                        <tbody>
                        @foreach (var order in data.RecentOrders)
                        {
                            <tr>
                                <td><a href="/Admin/AbrIT/Orders/@Uri.EscapeDataString(order.Id)">@order.Title</a></td>
                                <td><span class="abrit-status-badge">@order.Status</span></td>
                                <td class="abrit-dashboard-date">@order.Created</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <section class="abrit-dashboard-panel">
            <div class="abrit-dashboard-panel__heading">
                <div><span class="abrit-admin-eyebrow">مشتریان</span><h2>فعالیت اخیر</h2></div>
                <a href="/Admin/AbrIT/Customers">فهرست مشتریان <span aria-hidden="true">←</span></a>
            </div>
            @if (!data.RegistrationDatesAvailable)
            {
                <div class="abrit-admin-unavailable-state">
                    <span class="abrit-admin-unavailable-state__icon" aria-hidden="true">i</span>
                    <div>
                        <strong>زمان ثبت‌نام در دسترس نیست</strong>
                        <p>مدل حساب فعلی زمان ثبت‌نام را نگه نمی‌دارد؛ بنابراین فعالیت اخیر قابل محاسبه نیست.</p>
                    </div>
                </div>
            }
            else if (data.RecentCustomers.Count == 0)
            {
                <div class="abrit-admin-empty-state"><strong>مشتری‌ای برای نمایش وجود ندارد</strong></div>
            }
            else
            {
                <ul class="abrit-dashboard-customer-list">
                @foreach (var customer in data.RecentCustomers)
                {
                    <li><strong>@customer.UserName</strong><span>@customer.Email</span></li>
                }
                </ul>
            }
        </section>
    </div>

    <section class="abrit-dashboard-panel abrit-dashboard-health">
        <div class="abrit-dashboard-panel__heading">
            <div><span class="abrit-admin-eyebrow">وضعیت سامانه</span><h2>سلامت سرویس‌ها</h2></div>
        </div>
        <div class="abrit-dashboard-health__grid">
            <a class="abrit-dashboard-health-card" href="/Admin/AbrIT/Payments">
                <span class="abrit-dashboard-health-card__icon" aria-hidden="true"><i class="fa-solid fa-credit-card"></i></span>
                <span><strong>پرداخت‌ها</strong><small>@data.FailedPayments مورد ناموفق در ۱۰۰ تراکنش اخیر</small></span>
                <span class="abrit-dashboard-health-card__arrow" aria-hidden="true">←</span>
            </a>
            <a class="abrit-dashboard-health-card" href="/Admin/AbrIT/Sms">
                <span class="abrit-dashboard-health-card__icon" aria-hidden="true"><i class="fa-solid fa-comment-sms"></i></span>
                <span><strong>صف پیامک</strong><small>@data.SmsQueue پیامک در انتظار یا در حال تلاش</small></span>
                <span class="abrit-dashboard-health-card__arrow" aria-hidden="true">←</span>
            </a>
            <a class="abrit-dashboard-health-card" href="/Admin/AbrIT/Jobs">
                <span class="abrit-dashboard-health-card__icon" aria-hidden="true"><i class="fa-solid fa-gears"></i></span>
                <span><strong>کارهای پس‌زمینه</strong><small>@data.BackgroundJobs کار ثبت‌شده؛ تاریخچه اجرا در دسترس نیست</small></span>
                <span class="abrit-dashboard-health-card__arrow" aria-hidden="true">←</span>
            </a>
            <a class="abrit-dashboard-health-card" href="/Admin/AbrIT/Drive">
                <span class="abrit-dashboard-health-card__icon" aria-hidden="true"><i class="fa-solid fa-cloud"></i></span>
                <span><strong>AbrIT Drive</strong><small>@data.DriveConfiguration</small></span>
                <span class="abrit-dashboard-health-card__arrow" aria-hidden="true">←</span>
            </a>
            <a class="abrit-dashboard-health-card abrit-dashboard-health-card--unavailable" href="/Admin/AbrIT/Provisioning">
                <span class="abrit-dashboard-health-card__icon" aria-hidden="true"><i class="fa-solid fa-server"></i></span>
                <span><strong>راه‌اندازی سرویس</strong><small>وضعیت provisioning در منبع فعلی ثبت نمی‌شود</small></span>
                <span class="abrit-dashboard-health-card__arrow" aria-hidden="true">←</span>
            </a>
        </div>
    </section>

    @await DisplayAsync(await New.AdminDashboardContent())
</main>
