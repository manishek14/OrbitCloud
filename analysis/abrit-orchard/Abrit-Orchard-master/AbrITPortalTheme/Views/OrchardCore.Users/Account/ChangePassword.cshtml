@{ ViewLayout = "Layout__Login"; }
<div class="auth-shell">
  <section class="auth-card" style="max-width:560px;margin:0 auto">
    <div class="auth-card__head"><span class="eyebrow">امنیت حساب</span><h1>تغییر گذرواژه</h1><p>برای حفظ امنیت حساب، گذرواژه قوی و منحصربه‌فرد انتخاب کنید.</p></div>
    <div class="auth-card__body">
      @if (!ViewContext.ModelState.IsValid) { <div class="auth-error" role="alert">لطفاً خطاهای فرم را بررسی و دوباره تلاش کنید.</div> }
      @await DisplayAsync(Model)
      <div class="auth-links" style="margin-top:1rem"><a href="/account">بازگشت به حساب کاربری</a><a href="/customer/recover">فراموشی رمز؟ بازیابی با OTP</a></div>
    </div>
  </section>
</div>
