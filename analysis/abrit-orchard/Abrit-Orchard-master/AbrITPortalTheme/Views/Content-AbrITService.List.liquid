{% assign services = Queries.AllServices | query %}
<section class="portal-section services-section" aria-labelledby="services-title">
  <div class="page-heading">
    <div>
      <span class="eyebrow">AbrIT Cloud</span>
      <h1 id="services-title">سرویس‌های قابل ارائه</h1>
      <p>جزئیات خدمات را بررسی کنید. ثبت سفارش آنلاین در حال آماده‌سازی است.</p>
    </div>
  </div>
  {% if services.size > 0 %}
  <div class="service-grid">
    {% for service in services %}
    {% assign fields = service.Content.AbrITService %}
    <article class="service-card">
      <span class="service-card__icon" aria-hidden="true">{{ fields.Icon.Text | default: "◈" }}</span>
      <div class="service-card__body">
        <h2 class="service-card__title">{{ fields.title.Text | default: service.DisplayText }}</h2>
        <p class="service-card__description">{{ fields.Description.Text | default: "توضیحی ثبت نشده است." }}</p>
      </div>
      <div class="service-card__footer">
        <div class="service-card__price">
          <span>شروع قیمت</span>
          <strong class="service-card__price-value">{{ fields.Price.Value | default: "—" }} <span class="service-card__price-unit">تومان</span></strong>
        </div>
        <a class="portal-button portal-button--secondary" href="{{ service | display_url }}">جزئیات سرویس</a>
      </div>
      <div class="service-card__notice"><span>پرداخت و ثبت سفارش آنلاین در حال آماده‌سازی است.</span><span class="service-card__soon">به‌زودی</span></div>
    </article>
    {% endfor %}
  </div>
  {% else %}
  <div class="portal-empty-state">
    <div class="portal-empty-state__icon" aria-hidden="true">◈</div>
    <h2 class="portal-empty-state__title">سرویسی یافت نشد</h2>
    <p>در حال حاضر سرویسی برای نمایش ثبت نشده است.</p>
  </div>
  {% endif %}
</section>
