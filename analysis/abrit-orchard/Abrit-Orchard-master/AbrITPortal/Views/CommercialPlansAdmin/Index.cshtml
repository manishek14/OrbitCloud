@model AbrITPortal.Commercial.CommercialRules
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    var plans = Model.Plans.OrderBy(p => p.DisplayOrder).ToList();
}
<div class="abrit-admin-page" dir="rtl">
  <div class="page-heading"><div><span class="eyebrow">AbrIT Commercial</span><h1>مدیریت پلن‌های تجاری</h1><p>تنظیمات معتبر قیمت‌گذاری P1 تا P5، محدوده کاربران، SLA و سیاست قراردادها (۳/۶ ماهه). تغییرات روی سفارش‌های ثبت‌شده با snapshot قبلی اثر ندارد.</p></div></div>
  @if (TempData["Success"] is string ok) { <div class="alert alert-success" role="status">@ok</div> }
  @if (TempData["Error"] is string err) { <div class="alert alert-danger" role="alert">@err</div> }
  <div class="abrit-admin-kpis">
    <div class="abrit-admin-kpi"><span class="abrit-admin-kpi__label">تعداد پلن‌ها</span><strong class="abrit-admin-kpi__value">@plans.Count</strong></div>
    <div class="abrit-admin-kpi"><span class="abrit-admin-kpi__label">نسخه قیمت‌گذاری</span><strong class="abrit-admin-kpi__value">@Model.PricingVersion</strong></div>
    <div class="abrit-admin-kpi"><span class="abrit-admin-kpi__label">واحد پول</span><strong class="abrit-admin-kpi__value">@Model.Currency</strong></div>
  </div>
  <form asp-action="Save" asp-controller="CommercialPlansAdmin" asp-area="" method="post" id="commercial-rules-form">
    @Html.AntiForgeryToken()
    <section class="admin-section">
      <div class="abrit-admin-toolbar">
        <h2 style="margin:0">پلن‌ها (P1–P5)</h2>
        <span id="commercial-save-state" class="status-badge" role="status">مقادیر فعلی ذخیره شده‌اند</span>
      </div>
      <p class="text-muted">ویرایش‌های این فرم تا زمان انتخاب «ذخیره تنظیمات تجاری» اعمال نمی‌شوند.</p>
      <div class="table-scroll"><table class="table admin-table"><thead><tr><th>کد/نام</th><th>قیمت پایه ماهانه (تومان)</th><th>کاربران (شامل/حداقل/حداکثر)</th><th>کاربر اضافه/ماه</th><th>SLA</th><th>نمایش SLA</th><th>منتشر</th><th>ویژه</th></tr></thead><tbody>
        @for (var i = 0; i < plans.Count; i++)
        {
            var p = plans[i];
            <tr>
                <td><input type="hidden" name="Plans[@i].Code" value="@p.Code" /><strong>@p.Code</strong><div>@p.PersianName</div><small class="text-muted">@p.EnglishName</small></td>
                <td><input class="form-control" type="number" step="1" min="0" name="Plans[@i].BaseMonthlyPriceToman" value="@p.BaseMonthlyPriceToman" /></td>
                <td style="min-width:220px">
                    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:.35rem">
                      <label class="text-muted" style="font-size:.75rem">شامل<input class="form-control" type="number" name="Plans[@i].IncludedUsers" value="@p.IncludedUsers" /></label>
                      <label class="text-muted" style="font-size:.75rem">حداقل<input class="form-control" type="number" name="Plans[@i].MinimumUsers" value="@p.MinimumUsers" /></label>
                      <label class="text-muted" style="font-size:.75rem">حداکثر<input class="form-control" type="number" name="Plans[@i].MaximumUsers" value="@p.MaximumUsers" /></label>
                    </div>
                </td>
                <td><input class="form-control" type="number" step="1" min="0" name="Plans[@i].AdditionalUserMonthlyFeeToman" value="@p.AdditionalUserMonthlyFeeToman" /></td>
                <td>
                    <label style="display:flex;gap:.4rem;align-items:center;font-size:.85rem"><input type="checkbox" name="Plans[@i].SlaTypeImmediate" value="true" @(p.SlaType==AbrITPortal.Commercial.SlaType.Immediate?"checked":"") /> فوری/لحظه‌ای</label>
                    <input type="hidden" name="Plans[@i].SlaTypeImmediate" value="false" />
                    <input class="form-control" type="number" name="Plans[@i].SlaResponseMinutes" value="@(p.SlaResponseMinutes?.ToString() ?? "")" placeholder="دقیقه (زمان‌دار)" />
                </td>
                <td><input class="form-control" name="Plans[@i].SlaDisplayFa" value="@p.SlaDisplayFa" /></td>
                <td><input type="checkbox" name="Plans[@i].IsPublished" value="true" @(p.IsPublished?"checked":"") /><input type="hidden" name="Plans[@i].IsPublished" value="false" /></td>
                <td><input type="checkbox" name="Plans[@i].IsFeatured" value="true" @(p.IsFeatured?"checked":"") /><input type="hidden" name="Plans[@i].IsFeatured" value="false" /></td>
            </tr>
        }
      </tbody></table></div>
    </section>
    <section class="admin-section">
      <h2>سیاست قرارداد</h2>
      <div class="table-scroll"><table class="table admin-table"><thead><tr><th>مدت</th><th>نرخ تخفیف</th><th>نرخ راه‌اندازی (از قیمت پایه ماهانه)</th></tr></thead><tbody>
      @for (var i = 0; i < Model.Contracts.Count; i++)
      {
          var c = Model.Contracts.OrderBy(x => x.Months).ToList()[i];
          <tr>
              <td><input type="hidden" name="Contracts[@i].Months" value="@((int)c.Months)" />@((int)c.Months) ماهه</td>
              <td><input class="form-control" type="number" step="0.01" name="Contracts[@i].DiscountRate" value="@c.DiscountRate" /></td>
              <td><input class="form-control" type="number" step="0.01" name="Contracts[@i].OnboardingRateOfBaseMonthlyPrice" value="@c.OnboardingRateOfBaseMonthlyPrice" /></td>
          </tr>
      }
      </tbody></table></div>
      <div style="margin-top:1rem"><label for="tax-note"><strong>یادداشت مالیات</strong></label><input id="tax-note" class="form-control" name="TaxDisplayNote" value="@Model.TaxDisplayNote" /></div>
      <p class="text-muted" style="margin-top:.75rem">Endpoint در مدل تجاری وجود ندارد. قرارداد ۱۲ ماهه مجاز نیست. مقادیر مالیات اختراعی ثبت نمی‌شود.</p>
      <button class="btn btn-primary" type="submit">ذخیره تنظیمات تجاری</button>
    </section>
  </form>
  <section class="admin-section">
    <h2>پیش‌نمایش محاسبه (سرور معتبر)</h2>
    <p class="text-muted">پیش‌نمایش با قواعد ذخیره‌شده در سرور محاسبه می‌شود. برای محاسبه با مقادیر ویرایش‌شده، ابتدا آن‌ها را ذخیره کنید.</p>
    <form asp-action="Preview" asp-controller="CommercialPlansAdmin" asp-area="" method="post" id="preview-form" class="abrit-admin-toolbar" style="align-items:flex-end">
      @Html.AntiForgeryToken()
      <label>پلن<select class="form-control" name="planCode" required>@foreach(var p in plans){<option value="@p.Code">@p.Code - @p.PersianName</option>}</select></label>
      <label>تعداد کاربران<input class="form-control" type="number" name="selectedUsers" min="1" value="@(plans.FirstOrDefault()?.IncludedUsers ?? 4)" required /></label>
      <label>قرارداد<select class="form-control" name="contractMonths" required><option value="1">۱ ماهه</option><option value="3">۳ ماهه</option><option value="6">۶ ماهه</option></select></label>
      <button class="btn btn-secondary" type="submit">محاسبه</button>
    </form>
    <div id="pricing-preview-result" class="abrit-admin-result" role="status" aria-live="polite">
      <p class="abrit-admin-empty">پلن، تعداد کاربران و مدت قرارداد را انتخاب و محاسبه را اجرا کنید.</p>
    </div>
  </section>
</div>

<script>
(() => {
  const rulesForm = document.getElementById("commercial-rules-form");
  const saveState = document.getElementById("commercial-save-state");
  const previewForm = document.getElementById("preview-form");
  const previewResult = document.getElementById("pricing-preview-result");

  if (rulesForm && saveState) {
    const markUnsaved = () => {
      saveState.textContent = "تغییرات ذخیره‌نشده";
      saveState.classList.add("status-badge--warning");
    };
    rulesForm.addEventListener("input", markUnsaved);
    rulesForm.addEventListener("change", markUnsaved);
    rulesForm.addEventListener("submit", () => {
      saveState.textContent = "در حال ذخیره...";
    });
  }

  if (!previewForm || !previewResult) {
    return;
  }

  const readValue = (result, name) => result[name] ?? result[name[0].toUpperCase() + name.slice(1)];
  const formatValue = (value) => typeof value === "number"
    ? new Intl.NumberFormat("fa-IR").format(value)
    : String(value ?? "—");

  previewForm.addEventListener("submit", async (event) => {
    event.preventDefault();
    const button = previewForm.querySelector('button[type="submit"]');
    button.disabled = true;
    previewResult.setAttribute("aria-busy", "true");
    previewResult.replaceChildren();
    const loading = document.createElement("p");
    loading.className = "abrit-admin-empty";
    loading.textContent = "در حال محاسبه با موتور قیمت‌گذاری سرور...";
    previewResult.append(loading);

    try {
      const body = new URLSearchParams(new FormData(previewForm));
      const response = await fetch(previewForm.action, {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded;charset=UTF-8" },
        body,
        credentials: "same-origin"
      });
      if (!response.ok) {
        throw new Error(`خطا در محاسبه (HTTP ${response.status}).`);
      }

      const result = await response.json();
      const isValid = readValue(result, "isValid");
      const heading = document.createElement("h3");
      heading.textContent = isValid ? "نتیجه محاسبه" : "امکان محاسبه با این مقادیر وجود ندارد";
      previewResult.replaceChildren(heading);

      const fields = [
        ["پلن", "planCode"],
        ["نسخه قیمت‌گذاری", "pricingVersion"],
        ["تعداد کاربران", "selectedUsers"],
        ["کاربران اضافه", "additionalUsers"],
        ["مجموع ماهانه", "monthlyTotalToman"],
        ["مدت قرارداد (ماه)", "contractMonths"],
        ["مبلغ تخفیف", "discountAmountToman"],
        ["هزینه راه‌اندازی", "onboardingFeeToman"],
        ["مبلغ نهایی (تومان)", "finalTotalToman"],
        ["مبلغ نهایی (ریال)", "finalTotalRial"]
      ];
      const details = document.createElement("dl");
      details.className = "abrit-admin-result__grid";
      for (const [label, key] of fields) {
        const value = readValue(result, key);
        if (value === undefined || value === null) {
          continue;
        }
        const item = document.createElement("div");
        const term = document.createElement("dt");
        const description = document.createElement("dd");
        term.textContent = label;
        description.textContent = formatValue(value);
        details.append(item);
        item.append(term, description);
      }
      previewResult.append(details);

      const currency = readValue(result, "currency");
      if (currency) {
        const currencyNote = document.createElement("p");
        currencyNote.className = "text-muted";
        currencyNote.textContent = `واحد گزارش‌شده: ${currency}`;
        previewResult.append(currencyNote);
      }

      const errors = readValue(result, "errors");
      if (Array.isArray(errors) && errors.length > 0) {
        const errorList = document.createElement("ul");
        errorList.className = "abrit-admin-result__errors";
        for (const error of errors) {
          const item = document.createElement("li");
          item.textContent = error;
          errorList.append(item);
        }
        previewResult.append(errorList);
      }
    } catch (error) {
      previewResult.replaceChildren();
      const message = document.createElement("p");
      message.className = "alert alert-danger";
      message.setAttribute("role", "alert");
      message.textContent = error instanceof Error ? error.message : "خطای نامشخص هنگام محاسبه.";
      previewResult.append(message);
    } finally {
      button.disabled = false;
      previewResult.removeAttribute("aria-busy");
    }
  });
})();
</script>