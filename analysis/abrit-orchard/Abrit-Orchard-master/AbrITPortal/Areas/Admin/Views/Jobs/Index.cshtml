@model IEnumerable<AbrITPortal.Areas.Admin.Controllers.JobsAdminController.JobVm>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{ var count = Model?.Count() ?? 0; }
<div class="abrit-admin-page" dir="rtl">
  <div class="page-heading"><div><span class="eyebrow">AbrIT Operations</span><h1>کارهای پس‌زمینه</h1><p>وظایف زمان‌بندی‌شده ثبت‌شده در Orchard. تاریخچه/وضعیت اجرای هر سرور در ابزار بومی «Background Tasks» در دسترس است؛ صف پیامک با DB/Lease پایداری دارد.</p></div></div>
  <div class="abrit-admin-kpis">
    <div class="abrit-admin-kpi"><span class="abrit-admin-kpi__label">وظایف ثبت‌شده</span><strong class="abrit-admin-kpi__value">@count</strong></div>
  </div>
  <section class="admin-section">
    <h2>زمان‌بندی وظایف</h2>
    <div class="table-scroll"><table class="table admin-table"><thead><tr><th>نام وظیفه</th><th>زمان‌بندی (Cron)</th><th>آخرین اجرا</th><th>اجرای بعدی</th><th>وضعیت</th><th>آخرین خطا</th><th>توضیح</th></tr></thead><tbody>
    @if(Model != null){ foreach(var j in Model){ <tr><td class="cell-mono">@j.Name</td><td dir="ltr">@j.Schedule</td><td>@j.LastExecution</td><td>@j.NextExecution</td><td>@j.Status</td><td>@j.LastError</td><td>@j.Description</td></tr> } }
    @if(Model == null || !Model.Any()){ <tr><td colspan="7"><div class="portal-empty-state portal-empty-state--compact"><h3 class="portal-empty-state__title">وظیفه‌ای ثبت نشده است</h3></div></td></tr> }
    </tbody></table></div>
  </section>
</div>