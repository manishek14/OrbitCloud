@model AbrITPortal.Areas.Admin.Controllers.AdminOrdersPage
<div class="abrit-ops" dir="rtl">
    <a class="abrit-ops__back" href="/Admin/AbrIT">بازگشت به داشبورد</a>
    <header class="abrit-ops__page-heading"><span class="abrit-ops__eyebrow">مدیریت سفارش‌ها</span><h1>سفارش‌ها</h1><p>@Model.TotalCount سفارش منتشرشده. جزئیات فقط از فیلدهای ذخیره‌شده خوانده می‌شوند.</p></header>
    <form class="abrit-ops__filters" method="get" action="/Admin/AbrIT/Orders">
        <label for="order-query">جست‌وجو بر اساس شناسه، مشتری، سرویس یا وضعیت</label>
        <div><input id="order-query" name="q" value="@Model.Query" type="search" autocomplete="off" /><button type="submit">جست‌وجو</button>@if (!string.IsNullOrWhiteSpace(Model.Query)) { <a href="/Admin/AbrIT/Orders">پاک‌کردن</a> }</div>
    </form>
    @if (Model.Orders.Count == 0)
    {
        <div class="abrit-ops__empty"><h2>سفارشی یافت نشد</h2><p>در حال حاضر سفارشی مطابق فیلتر وجود ندارد.</p></div>
    }
    else
    {
        <div class="abrit-ops__table-wrap"><table class="abrit-ops__table">
            <thead><tr><th>شناسه</th><th>مشتری</th><th>سرویس</th><th>تاریخ</th><th>مبلغ ذخیره‌شده</th><th>وضعیت</th><th></th></tr></thead>
            <tbody>
            @foreach (var order in Model.Orders)
            {
                <tr><td class="abrit-ops__mono">@order.OrderId</td><td>@order.CustomerName</td><td>@order.Service</td><td dir="ltr">@order.CreatedUtc?.ToString("yyyy/MM/dd")</td><td>@order.Price</td><td><span class="abrit-ops__badge">@order.Status</span></td><td><a href="/Admin/AbrIT/Orders/@Uri.EscapeDataString(order.OrderId)">جزئیات</a></td></tr>
            }
            </tbody>
        </table></div>
        <nav class="abrit-ops__pagination" aria-label="صفحه‌بندی سفارش‌ها">
            <span>صفحه @Model.Page از @Model.PageCount</span>
            @if (Model.Page > 1) { <a href="/Admin/AbrIT/Orders?q=@Uri.EscapeDataString(Model.Query ?? "")&page=@(Model.Page - 1)">قبلی</a> }
            @if (Model.Page < Model.PageCount) { <a href="/Admin/AbrIT/Orders?q=@Uri.EscapeDataString(Model.Query ?? "")&page=@(Model.Page + 1)">بعدی</a> }
        </nav>
    }
</div>
