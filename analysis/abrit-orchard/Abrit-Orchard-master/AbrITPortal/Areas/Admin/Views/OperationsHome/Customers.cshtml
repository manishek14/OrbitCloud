@model AbrITPortal.Areas.Admin.Controllers.AdminCustomersPage
<div class="abrit-ops" dir="rtl">
    <a class="abrit-ops__back" href="/Admin/AbrIT">بازگشت به داشبورد</a>
    <header class="abrit-ops__page-heading"><span class="abrit-ops__eyebrow">مدیریت مشتریان</span><h1>مشتریان</h1><p>@Model.TotalCount حساب کاربری مطابق جست‌وجو. وضعیت‌ها از Orchard Identity خوانده شده‌اند.</p></header>
    <form class="abrit-ops__filters" method="get" action="/Admin/AbrIT/Customers">
        <label for="customer-query">جست‌وجو بر اساس نام کاربری، ایمیل یا شماره همراه</label>
        <div><input id="customer-query" name="q" value="@Model.Query" type="search" autocomplete="off" /><button type="submit">جست‌وجو</button>@if (!string.IsNullOrWhiteSpace(Model.Query)) { <a href="/Admin/AbrIT/Customers">پاک‌کردن</a> }</div>
    </form>
    @if (Model.Customers.Count == 0)
    {
        <div class="abrit-ops__empty"><h2>مشتری‌ای یافت نشد</h2><p>عبارت جست‌وجو را تغییر دهید یا بعداً دوباره بررسی کنید.</p></div>
    }
    else
    {
        <div class="abrit-ops__table-wrap"><table class="abrit-ops__table">
            <thead><tr><th>نام کاربری</th><th>ایمیل</th><th>همراه</th><th>تأیید ایمیل</th><th>تأیید همراه</th><th>وضعیت ورود</th><th>سفارش‌ها</th><th></th></tr></thead>
            <tbody>
            @foreach (var customer in Model.Customers)
            {
                <tr>
                    <td>@customer.UserName</td><td dir="ltr">@customer.Email</td><td dir="ltr">@customer.Mobile</td>
                    <td><span class="abrit-ops__badge @(customer.EmailConfirmed ? "is-ready" : "is-pending")">@(customer.EmailConfirmed ? "تأییدشده" : "تأییدنشده")</span></td>
                    <td><span class="abrit-ops__badge @(customer.MobileConfirmed ? "is-ready" : "is-pending")">@(customer.MobileConfirmed ? "تأییدشده" : "تأییدنشده")</span></td>
                    <td>@(customer.IsLockedOut ? "قفل ورود" : "بدون قفل فعال")</td><td>@customer.OrderCount</td>
                    <td><a href="/Admin/AbrIT/Customers/@Uri.EscapeDataString(customer.UserId)">جزئیات</a></td>
                </tr>
            }
            </tbody>
        </table></div>
        <nav class="abrit-ops__pagination" aria-label="صفحه‌بندی مشتریان">
            <span>صفحه @Model.Page از @Model.PageCount</span>
            @if (Model.Page > 1) { <a href="/Admin/AbrIT/Customers?q=@Uri.EscapeDataString(Model.Query ?? "")&page=@(Model.Page - 1)">قبلی</a> }
            @if (Model.Page < Model.PageCount) { <a href="/Admin/AbrIT/Customers?q=@Uri.EscapeDataString(Model.Query ?? "")&page=@(Model.Page + 1)">بعدی</a> }
        </nav>
    }
    <p class="abrit-ops__footnote">رمز عبور، OTP، توکن‌ها و مقادیر احراز هویت در این نما خوانده یا نمایش داده نمی‌شوند.</p>
</div>
