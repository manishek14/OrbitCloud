@model AbrITPortal.Areas.Admin.Controllers.AdminOrderRow
<div class="abrit-ops" dir="rtl">
    <a class="abrit-ops__back" href="/Admin/AbrIT/Orders">بازگشت به سفارش‌ها</a>
    <header class="abrit-ops__page-heading"><span class="abrit-ops__eyebrow">جزئیات سفارش</span><h1 class="abrit-ops__mono">@Model.OrderId</h1></header>
    <section class="abrit-ops__section"><h2>اطلاعات ثبت‌شده</h2><dl class="abrit-ops__details">
        <div><dt>مشتری</dt><dd>@Model.CustomerName</dd></div><div><dt>شناسه مشتری</dt><dd class="abrit-ops__mono">@Model.CustomerId</dd></div>
        <div><dt>سرویس</dt><dd>@Model.Service</dd></div><div><dt>تاریخ ثبت</dt><dd dir="ltr">@Model.CreatedUtc?.ToString("yyyy/MM/dd HH:mm")</dd></div>
        <div><dt>مبلغ ذخیره‌شده</dt><dd>@Model.Price</dd></div><div><dt>وضعیت</dt><dd>@Model.Status</dd></div>
    </dl></section>
    <div class="abrit-ops__notice" role="status">پلن انتخابی، مدت قرارداد، تفکیک مالی و وضعیت پرداخت/راه‌اندازی در رکورد این سفارش وجود ندارد؛ این اطلاعات از روی پرداخت یا کاتالوگ حدس زده نمی‌شوند.</div>
</div>
