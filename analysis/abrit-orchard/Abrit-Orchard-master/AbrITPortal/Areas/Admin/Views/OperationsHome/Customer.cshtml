@model AbrITPortal.Areas.Admin.Controllers.AdminCustomerDetails
<div class="abrit-ops" dir="rtl">
    <a class="abrit-ops__back" href="/Admin/AbrIT/Customers">بازگشت به مشتریان</a>
    <header class="abrit-ops__page-heading"><span class="abrit-ops__eyebrow">پرونده مشتری</span><h1>@Model.UserName</h1><p>شناسه حساب: <span class="abrit-ops__mono">@Model.UserId</span></p></header>
    <div class="abrit-ops__detail-grid">
        <section class="abrit-ops__section"><h2>اطلاعات حساب</h2><dl class="abrit-ops__details">
            <div><dt>نام کاربری</dt><dd>@Model.UserName</dd></div><div><dt>ایمیل</dt><dd dir="ltr">@Model.Email</dd></div><div><dt>وضعیت ایمیل</dt><dd>@(Model.EmailConfirmed ? "تأییدشده" : "تأییدنشده")</dd></div>
            <div><dt>شماره همراه</dt><dd dir="ltr">@(string.IsNullOrWhiteSpace(Model.Mobile) ? "ثبت نشده" : Model.Mobile)</dd></div><div><dt>وضعیت همراه</dt><dd>@(Model.MobileConfirmed ? "تأییدشده" : "تأییدنشده")</dd></div>
            <div><dt>وضعیت ورود</dt><dd>@(Model.IsLockedOut ? "قفل ورود فعال" : "بدون قفل فعال")</dd></div>
        </dl></section>
        <section class="abrit-ops__section"><h2>سفارش‌ها</h2>
            @if (Model.Orders.Count == 0) { <div class="abrit-ops__empty"><p>سفارشی برای این حساب ثبت نشده است.</p></div> }
            else
            {
                <div class="abrit-ops__table-wrap"><table class="abrit-ops__table"><thead><tr><th>شناسه</th><th>سرویس</th><th>تاریخ</th><th>مبلغ ذخیره‌شده</th><th>وضعیت</th></tr></thead><tbody>
                @foreach (var order in Model.Orders) { <tr><td><a href="/Admin/AbrIT/Orders/@Uri.EscapeDataString(order.OrderId)">@order.OrderId</a></td><td>@order.Service</td><td dir="ltr">@order.CreatedUtc?.ToString("yyyy/MM/dd")</td><td>@order.Price</td><td>@order.Status</td></tr> }
                </tbody></table></div>
            }
        </section>
        <section class="abrit-ops__section"><h2>خدمات فعال</h2><p class="abrit-ops__unavailable">موجودیت سرویس تخصیص‌یافته یا تاریخچه عملیاتی به حساب متصل نشده است.</p></section>
        <section class="abrit-ops__section"><h2>تاریخچه عملیاتی</h2><p class="abrit-ops__unavailable">رویدادهای حساب در منبع پایدار ثبت نمی‌شوند.</p></section>
    </div>
</div>
