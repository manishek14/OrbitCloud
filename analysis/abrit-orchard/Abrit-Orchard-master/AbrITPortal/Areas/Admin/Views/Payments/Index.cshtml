@model IReadOnlyList<AbrITPortal.Payments.PaymentAttemptRecord>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    var providers = ViewBag.Providers as IEnumerable<dynamic> ?? Array.Empty<dynamic>();
    var count = Model?.Count ?? 0;
}
<div class="abrit-admin-page" dir="rtl">
  <div class="page-heading"><div><span class="eyebrow">AbrIT Operations</span><h1>مدیریت پرداخت‌ها</h1><p>وضعیت ارائه‌دهندگان و تلاش‌های پرداخت. درگاه‌های زنده بدون پیکربندی/تأیید قرارداد فعال نیستند و خرید عمومی تا M3 غیرفعال است.</p></div></div>
  @if (TempData["Success"] is string ok){ <div class="alert alert-success" role="status">@ok</div> }
  <div class="abrit-admin-kpis">
    <div class="abrit-admin-kpi"><span class="abrit-admin-kpi__label">تعداد تلاش‌های اخیر</span><strong class="abrit-admin-kpi__value">@count</strong></div>
    <div class="abrit-admin-kpi"><span class="abrit-admin-kpi__label">ارائه‌دهندگان ثبت‌شده</span><strong class="abrit-admin-kpi__value">@providers.Count()</strong></div>
    <div class="abrit-admin-kpi"><span class="abrit-admin-kpi__label">وضعیت خرید عمومی</span><strong class="abrit-admin-kpi__value">غیرفعال (M3)</strong></div>
  </div>
  <section class="admin-section">
    <h2>ارائه‌دهندگان پرداخت</h2>
    <div class="table-scroll"><table class="table admin-table"><thead><tr><th>کد</th><th>فعال</th><th>قابلیت‌ها</th></tr></thead><tbody>
    @foreach(var p in providers){ <tr><td class="cell-mono">@p.Code</td><td>@(p.Enabled ? "بله" : "خیر")</td><td>@p.Capabilities</td></tr> }
    @if(!providers.Any()){ <tr><td colspan="3"><div class="portal-empty-state portal-empty-state--compact"><h3 class="portal-empty-state__title">ارائه‌دهنده‌ای ثبت نشده است</h3><p>پس از ثبت ارائه‌دهنده، وضعیت در این بخش نمایش داده می‌شود.</p></div></td></tr> }
    </tbody></table></div>
  </section>
  <section class="admin-section">
    <div class="abrit-admin-toolbar"><h2 style="margin:0">تلاش‌های پرداخت</h2>
      <form asp-action="Reconcile" method="post">@Html.AntiForgeryToken()<button class="btn btn-secondary" type="submit">اجرای تطبیق (در انتظار/مبهم)</button></form>
    </div>
    <div class="table-scroll"><table class="table admin-table"><thead><tr><th>شناسه تلاش</th><th>Tenant</th><th>سفارش</th><th>ارائه‌دهنده</th><th>وضعیت</th><th>وضعیت تراکنش</th><th>مبلغ اصلی</th><th>مبلغ درگاه</th><th>Authority</th><th>مرجع</th><th>به‌روزرسانی</th><th>خطا</th></tr></thead><tbody>
    @if(Model != null){ foreach(var a in Model){ <tr><td class="cell-mono">@a.AttemptId</td><td>@a.TenantId</td><td class="cell-mono">@a.OrderId</td><td>@a.ProviderCode</td><td><span class="status-badge">@a.Status</span></td><td>@a.TransactionState</td><td>@a.OriginalAmount @a.OriginalCurrency</td><td>@a.ProviderAmount @a.ProviderCurrency</td><td class="cell-mono">@a.GatewayAuthority</td><td class="cell-mono">@a.GatewayReference</td><td dir="ltr">@a.UpdatedUtc</td><td>@a.ErrorCategory @a.LastError</td></tr> } }
    @if(Model == null || !Model.Any()){ <tr><td colspan="12"><div class="portal-empty-state portal-empty-state--compact"><h3 class="portal-empty-state__title">تلاشی ثبت نشده است</h3><p>هنوز رکورد پرداختی در این محیط موجود نیست.</p></div></td></tr> }
    </tbody></table></div>
  </section>
</div>