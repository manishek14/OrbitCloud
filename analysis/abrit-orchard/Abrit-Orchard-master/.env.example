# AbrIT Portal - integration configuration template (PLACEHOLDERS ONLY)
# Do not commit real secrets. Use environment variables / User Secrets / approved secret manager.

# --- SMS.ir (live disabled until verified contract + credentials) ---
ABRIT_SMSIR_ENABLED=false
ABRIT_SMSIR_ENVIRONMENT=Disabled # Disabled|Mock|Sandbox|Live
ABRIT_SMSIR_API_BASE_URL=https://api.sms.ir
ABRIT_SMSIR_API_KEY=
ABRIT_SMSIR_LINE_NUMBER=
ABRIT_SMSIR_OTP_TEMPLATE_ID=

# --- Payments: global ---
ABRIT_PAYMENTS_DEFAULT_PROVIDER=mock
ABRIT_PAYMENTS_ALLOW_PUBLIC_CHECKOUT=false
ABRIT_PAYMENTS_CALLBACK_BASE_URL=

# --- Behpardakht Mellat (disabled) ---
ABRIT_MELLAT_ENABLED=false
ABRIT_MELLAT_ENVIRONMENT=Disabled
ABRIT_MELLAT_TERMINAL_ID=
ABRIT_MELLAT_USERNAME=
ABRIT_MELLAT_PASSWORD=
ABRIT_MELLAT_WSDL_URL=
ABRIT_MELLAT_CALLBACK_PATH=/payments/callback/mellat

# --- ZarinPal (disabled) ---
ABRIT_ZARINPAL_ENABLED=false
ABRIT_ZARINPAL_ENVIRONMENT=Disabled
ABRIT_ZARINPAL_USE_SANDBOX=true
ABRIT_ZARINPAL_MERCHANT_ID=
ABRIT_ZARINPAL_REQUEST_URL=
ABRIT_ZARINPAL_VERIFY_URL=
ABRIT_ZARINPAL_STARTPAY_BASE_URL=
ABRIT_ZARINPAL_CALLBACK_PATH=/payments/callback/zarinpal

# --- Zibal (disabled) ---
ABRIT_ZIBAL_ENABLED=false
ABRIT_ZIBAL_ENVIRONMENT=Disabled
ABRIT_ZIBAL_MERCHANT_ID=
ABRIT_ZIBAL_REQUEST_URL=https://gateway.zibal.ir/v1/request
ABRIT_ZIBAL_VERIFY_URL=https://gateway.zibal.ir/v1/verify
ABRIT_ZIBAL_STARTPAY_BASE_URL=https://gateway.zibal.ir/start/
ABRIT_ZIBAL_CALLBACK_PATH=/payments/callback/zibal

# --- SMS queue / background ---
ABRIT_SMS_QUEUE_ENABLED=true
ABRIT_SMS_QUEUE_BATCH_SIZE=20
ABRIT_SMS_QUEUE_MAX_ATTEMPTS=8
ABRIT_SMS_QUEUE_LEASE_SECONDS=60
ABRIT_SMS_QUEUE_BASE_RETRY_SECONDS=30
ABRIT_SMS_QUEUE_MAX_RETRY_SECONDS=3600
ABRIT_SMS_QUEUE_RATE_LIMIT_PER_MINUTE=60
ABRIT_SMS_QUEUE_RETENTION_DAYS=30
